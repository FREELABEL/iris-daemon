node_modules/
.env
daemon-data/
*.log
.DS_Store

# Secrets / auth (never commit)
youtube-auth.json
som/youtube-auth.json
instagram-auth-*.json

# Local runtime state
native-imessage-state.json
.uptime-monitor-state.json

# Test artifacts
test-results/
som/test-results/

# Runtime cache, not source. It changes on every campaign fetch.
som/.som-campaigns-cache.json

# Paired R1 device registry — runtime state, holds per-device token hashes.
r1-devices.json

# Python bytecode
__pycache__/
*.pyc

# Install manifest written by `iris daemon update` (#191614): which commit this copy is.
.iris-daemon-version.json

# Runtime files the daemon writes into this directory that were not listed (#191614 audit).
# `iris daemon update` carries every ignored file over to the new version, so a runtime file
# missing here would be refused as an "untracked local change" instead.
r1-frames.jsonl
ollama-sessions/
*-auth-backup.json
.output/
